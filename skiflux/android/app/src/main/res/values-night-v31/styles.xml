<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      From API 31 the platform composites its own splash over the launch window
      and cannot be opted out of. Left alone it draws the launcher icon on the
      window background — the "black screen with the app icon" the Lottie is
      meant to replace. Blanking the icon leaves the flat colour the animation
      opens on, so the system splash and `_SplashScreen` read as one screen.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
