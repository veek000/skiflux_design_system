<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The window between the launcher tap and Flutter's first frame.

      Both themes are the light variant on purpose. `Theme.Black` here is what
      produced the black launch window in dark mode, and the splash animation
      opens on white regardless of the OS theme — the launch window has to match
      the animation, not the system setting.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!--
      The window behind Flutter's own UI once the engine is up. Pinned to the
      same colour so a slow frame shows the splash colour rather than a flash of
      the platform default.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
