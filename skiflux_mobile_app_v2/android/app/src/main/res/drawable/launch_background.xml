<?xml version="1.0" encoding="utf-8"?>
<!--
  The window the OS shows between the tap and Flutter's first frame.

  Deliberately a flat fill and nothing else: the brand moment is the Lottie in
  `_SplashScreen`, and an icon drawn here would be a second, competing splash
  the user sees first. The colour is the animation's opening frame, so the
  handover is invisible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
